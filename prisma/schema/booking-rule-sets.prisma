model BookingRuleSet {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name      String
  nameKey   String
  rules     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([siteId, nameKey])
}
